
FROM docker:27-cli AS docker-cli

FROM python:3.12-slim AS python-tools

FROM jenkins/jenkins:lts-jdk21

USER root

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker

COPY --from=python-tools /usr/local/bin/python3 /usr/local/bin/python3
COPY --from=python-tools /usr/local/bin/python /usr/local/bin/python
COPY --from=python-tools /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=python-tools /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/

USER jenkins
